{
  "name": "@repo/database",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "npx prisma@5.22.0 generate --schema=../../prisma/schema.prisma && npx -p typescript@5.9.3 tsc",
    "db:generate": "cd ../.. && npx prisma@5.22.0 generate --schema=./prisma/schema.prisma",
    "db:migrate": "cd ../.. && npx prisma@5.22.0 migrate deploy --schema=./prisma/schema.prisma",
    "db:migrate:dev": "cd ../.. && npx prisma@5.22.0 migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "cd ../.. && npx prisma@5.22.0 studio --schema=./prisma/schema.prisma",
    "db:seed": "cd ../.. && npx prisma@5.22.0 generate --schema=./prisma/schema.prisma && NODE_NO_WARNINGS=1 tsx packages/database/src/seed.ts"
  },
  "prisma": {
    "schema": "../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "5.9.3"
  }
}
