    </target>

    <target name="input-quote-id-property" unless="quote.id">
        <input message="Please enter Quote Id:" addproperty="quote.id"/>
    </target>

    <target name="sample" depends="check-customer-property" description="Run sample (without compiling)">
        <java classname="com.pace2020.epace.sdk.sample.Sample" fork="true">
            <classpath refid="jaxws.classpath"/>
            <classpath refid="tools.classpath"/>
            <classpath location="${build.dest}"/>
            <jvmarg value="-Depace.username=${epace.username}"/>
            <jvmarg value="-Depace.password=${epace.password}"/>
            <arg value="${customer.code}"/>
        </java>
    </target>
	
	<target name="transactionSample" description="Run transaction sample">
	        <java classname="com.pace2020.epace.sdk.sample.TransactionServiceSample" fork="true">
	            <classpath refid="jaxws.classpath"/>
