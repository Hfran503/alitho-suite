           </java>
       </target>

       <target name="run-sample" depends="compile, sample" description="Compile and run sample"/>


    <target name="receive-po-line" depends="check-poline-id-property, check-poline-unitprice-property, check-poline-qtyreceived-property, check-poline-serialid-property, check-poline-numids-property, check-poline-bin-property" 
