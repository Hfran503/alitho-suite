    <target name="compile-tests" depends="jar, copy-junit-test-files">
        <mkdir dir="${build.testclasses}"/>
        <mkdir dir="${build.tests}"/>

        <copy todir="${build.testclasses}">
            <fileset dir="${test.dir}"/>
        </copy>

        <javac destdir="${build.testclasses}" debug="true" source="${jdk_version}">
            <classpath refid="test.class.path"/>
            <classpath refid="jaxws.classpath"/>
            <classpath refid="tools.classpath"/>
            <src path="${test.dir}"/>
        </javac>

        <jar jarfile="${build.testclasses}/suite_tests.jar">
            <fileset dir="${build.testclasses}">
                <exclude name="**/Abstract*.class"/>
                <include name="com/pace2020/epace/sdk/**/*TestCase.class"/>
            </fileset>
        </jar>
    </target>

    <target name="copy-junit-test-files">
        <mkdir dir="${build.testclasses}"/>
        <mkdir dir="${build.tests}"/>

        <copy todir="${build.testclasses}">
            <fileset dir="${test.dir}">
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
                <include name="**/*.xls"/>
                <include name="**/*.txt"/>
                <include name="**/*.csv"/>
                <include name="**/*.xsd"/>
                <include name="**/*.pdf"/>
                <include name="**/*.jpg"/>
                <include name="**/*.xconf"/>
                <include name="**/*.txt"/>
            </fileset>
        </copy>

        <copy todir="${build.testclasses}">
            <fileset dir="${build.dest}">
                <include name="**/*.properties"/>
                <include name="**/*.xml"/>
                <include name="**/*.xls"/>
                <include name="**/*.txt"/>
                <include name="**/*.csv"/>
                <include name="**/*.xsd"/>
                <include name="**/*.pdf"/>
                <include name="**/*.jpg"/>
                <include name="**/*.dtd"/>
                <include name="**/*.xconf"/>
                <include name="**/*.txt"/>
            </fileset>
        </copy>

        <copy todir="${build.testclasses}">
            <fileset dir="${java.dir}">
                <include name="**/*.roles"/>
                <include name="**/*.properties"/>
                <include name="**/*.xsl"/>
                <include name="**/*.xsd"/>
                <include name="**/*.jelly"/>
                <include name="**/*.drl"/>
                <include name="**/*.js"/>
                <include name="**/*.mxinfo"/>
                <include name="**/*.dtd"/>
                <include name="**/*.ent"/>
                <include name="**/*.sql"/>
                <include name="**/*.pdf"/>
                <include name="**/*.xml"/>
                <include name="**/*.types"/>
                <include name="**/*.txt"/>
            </fileset>
        </copy>
    </target>

    <target name="sdk-tests">
        <!-- used only by Pace when building Pace remove these when trying to use this ant target -->
        <property file="../../../../../epace.version.properties"/>
        <property name="deb.version" value="${version}-${build.testnumber}"/>
        <property name="MailLogger.failure.subject" value="[${deb.version}] **SDK TESTS FAILED**"/>

        <junit fork="true"
               haltonfailure="false"
               failureproperty="sdk.tests.failed"
               printsummary="withOutAndErr"
               maxmemory="2024M"
               dir="${build.tests}">
           <!-- <jvmarg value="-Xdebug"/>
            <jvmarg value="-Xnoagent"/>
            <jvmarg value="-Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005"/>
            -->
            <jvmarg value="-Depace.username=${epace.username}"/>
            <jvmarg value="-Depace.password=${epace.password}"/>
            <jvmarg value="-Dorg.apache.cxf.stax.maxChildElement=100000"/>

            <classpath refid="test.class.path"/>
            <classpath refid="jaxws.classpath"/>
            <classpath refid="tools.classpath"/>
            <formatter type="plain" usefile="false"/>

            <batchtest>
                <fileset dir="${build.testclasses}">
                    <include name="com/pace2020/epace/sdk/suite/TestSuite.class"/>
                </fileset>
            </batchtest>
        </junit>

        <!-- used only by Pace when building Pace remove these when trying to use this ant target -->
        <antcall target="clean"/>
        <fail message="${MailLogger.failure.subject}" if="sdk.tests.failed"/>
    </target>

    <target name="clean" description="Cleans the build directories">
        <delete quiet="true" dir="${build.dir}"/>
    </target>

