    <target name="check-paceconnect-type-property" unless="paceconnect.type" depends="input-paceconnect-type-property">
        <fail message="must pass 'paceconnect.type'"/>
    </target>

    <target name="input-paceconnect-type-property" unless="paceconnect.type">
