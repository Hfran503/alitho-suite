<project name="epace sdk" basedir="." default="run-sample">
    <property name="build.compiler.emacs" value="on"/>
    <property name="build.compiler.pedantic" value="false"/>
    <property name="build.compiler.depend" value="true"/>
    <property name="build.compiler.fulldepend" value="true"/>
    <property name="build.compiler" value="modern"/>
    
    <property file="build.properties"/>
    <property name="jdk_version" value="1.8"/>
    <!-- Host/Port of epace instance to connect to-->
    <property name="epace.host" value="localhost"/>
    <property name="epace.port" value="80"/>

    <!-- Username and password to use. This will likely be different, but will work on a fresh install -->
    <property name="epace.username" value="Administrator"/>
    <property name="epace.password" value="pace"/>

    <!-- Set up paths -->
    <property name="build.dir" value="./build"/>
    <property name="build.dest" value="./build/classes"/>
    <property name="gensrc.dir" value="./build/gensrc"/>
    <property name="wsdl.dir" value="./build/wsdl"/>
    <property name="lib.dir" value="./lib"/>
    <property name="tools.dir" value="./tools/lib"/>
    <property name="src.dir" value="./src"/>
    <property name="java.dir" value="${src.dir}/main"/>
    <property name="lib.jaxws.dir" value="${lib.dir}/cxf"/>

    <!-- JUNIT tests -->
    <property name="test.dir" value="${src.dir}/test/"/>
    <property name="build.testclasses" value="${build.dir}/testclasses"/>
    <property name="build.tests" value="${build.dir}/tests"/>
    <property name="junit.failonerror" value="true"/>


    <!-- Create classpath entry for JAXWS -->
    <path id="jaxws.classpath">
        <pathelement location="${java.home}/../lib/tools.jar"/>
        <fileset dir="${lib.jaxws.dir}">
            <include name="*.jar"/>
        </fileset>
    </path>


    <!-- Create classpath entry for test -->
    <path id="test.class.path">
        <pathelement location="${build.testclasses}"/>
        <pathelement location="${build.dest}"/>
        <path refid="jaxws.classpath"/>
        <path refid="tools.classpath"/>
        <fileset dir="${build.dir}/dist">
            <include name="*.jar"/>
        </fileset>
    </path>

    <!-- Create classpath entry for tools-->
    <path id="tools.classpath">
        <fileset dir="./tools/lib/">
            <include name="*.jar"/>
        </fileset>
        <fileset dir="${lib.dir}">
            <include name="**/*.jar"/>  
        </fileset>
    </path>

    <taskdef name="wsimport" classname="com.sun.tools.ws.ant.WsImport">
		<classpath refid="tools.classpath"/>
	</taskdef>

    <target name="setup">
		<mkdir dir="${build.dir}"/>
		<mkdir dir="${src.dir}"/>
		<mkdir dir="${build.dest}"/>
		<mkdir dir="${wsdl.dir}"/>
	</target>

    <target name="download-wsdl">
		<get
			username="${epace.username}"
			password="${epace.password}"
			src="http://${epace.host}:${epace.port}/rpc/services/${service.name}?wsdl"
			dest="${wsdl.dir}/${service.name}.wsdl"/>
	</target>

	<target name="get-wsdl" description="retrieve wsdl files from epace" depends="setup">
        <mkdir dir="${wsdl.dir}"/>

		<antcall target="download-wsdl">
			<param name="service.name" value="Version" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="FindObjects"/>
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="ReadObject" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="UpdateObject" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="CreateObject" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="CloneObject" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="DeleteObject" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="InvokeAction" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="InvokeProcess" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="InvokePaceConnect" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="SystemInspector" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="AttachmentService" />
		</antcall>
        <antcall target="download-wsdl">
			<param name="service.name" value="GeoLocate" />
		</antcall>
        <antcall target="download-wsdl">
			<param name="service.name" value="CustomizationService" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="ReportService" />
		</antcall>
		<antcall target="download-wsdl">
			<param name="service.name" value="TransactionService" />
		</antcall>
	</target>

    <target name="wsdl2java">
        <wsimport
        	destdir="${build.dest}"
        	sourcedestdir="${gensrc.dir}"
            wsdl="${basedir}/build/wsdl/${name}.wsdl"
        	wsdllocation="http://${epace.host}:${epace.port}/rpc/services/${name}?wsdl">

			<binding dir="${basedir}/etc" includes="Bindings.xml"/>
		</wsimport>
    </target>

    <target name="gen-src" depends="get-wsdl" description="generate java source from wsdl files">
        <mkdir dir="${gensrc.dir}"/>

        <antcall target="wsdl2java">
            <param name="name" value="CreateObject"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="ReadObject"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="CloneObject"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="InvokeAction"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="UpdateObject"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="DeleteObject"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="FindObjects"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="InvokeProcess"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="InvokePaceConnect"/>
        </antcall>

        <antcall target="wsdl2java">
            <param name="name" value="Version"/>
        </antcall>
    	<antcall target="wsdl2java">
    	    <param name="name" value="TransactionService"/>
    	</antcall>

        <antcall target="wsdl2java">
            <param name="name" value="SystemInspector"/>
        </antcall>
        
        <antcall target="wsdl2java">
            <param name="name" value="AttachmentService"/>
        </antcall>
    	
    	<antcall target="wsdl2java">
    	    <param name="name" value="GeoLocate"/>
    	</antcall>

    	<antcall target="wsdl2java">
    	    <param name="name" value="CustomizationService"/>
    	</antcall>

    	<antcall target="wsdl2java">
    		<param name="name" value="ReportService"/>
    	</antcall>
    </target>

    <target name="compile" depends="gen-src">
        <mkdir dir="${build.dest}"/>

        <javac destdir="${build.dest}" target="${jdk_version}" source="${jdk_version}">
            <src path="${java.dir}"/>
            <src path="${gensrc.dir}"/>
            <classpath refid="tools.classpath"/>
            <classpath refid="jaxws.classpath"/>
        </javac>
    </target>

    <target name="check-customer-property" unless="customer.code" depends="input-customer-property">
        <fail message="must pass 'customer.code' (ex, -Dcustomer.code=TEST)"/>
    </target>

    <target name="input-customer-property" unless="customer.code">
        <input message="Please enter customer code:" addproperty="customer.code"/>
    </target>

	<target name="check-estimate-property" unless="estimate.number" depends="input-estimate-property">
	    <fail message="must pass 'estimate.number' (ex, -Destimate.number=TEST)"/>
	</target>

	<target name="input-estimate-property" unless="estimate.number">
		<input message="Please enter estimate number :" addproperty="estimate.number"/>
	</target>

    <target name="check-chargeback-number-property" unless="chargeback.number" depends="input-chargeback-number-property">
        <fail message="must pass 'chargeback.number' (ex, -Dchargeback.number=TEST)"/>
    </target>

    <target name="input-chargeback-number-property" unless="chargeback.number">
        <input message="Please enter chargeback number:" addproperty="chargeback.number"/>
    </target>

    <target name="check-job-property" unless="job.job" depends="input-job-property">
        <fail message="must pass 'job.job' (ex, -Djob.job=1234)"/>
