    <target name="check-poline-bin-property" unless="poline.bin" depends="input-poline-bin-property">
        <fail message="must pass 'poline.bin' (ex, -Dpoline.bin=1234)"/>
    </target>

    <target name="input-poline-bin-property" unless="poline.bin">
