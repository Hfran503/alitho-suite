generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  plan                   String                  @default("free")
  status                 String                  @default("active")
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  attachments            Attachment[]
  auditLogs              AuditLog[]
  batchImports           BatchImport[]
  batchImportsV2         BatchImportV2[]
  carrierServiceMappings CarrierServiceMapping[]
  departments            Department[]
  equipment              Equipment[]
  integrations           Integration[]
  invoiceIntegrations      InvoiceIntegration[]
  poLineIntegrations       PoLineIntegration[]
  poReceiptIntegrations    PoReceiptIntegration[]
  vendorBillIntegrations   VendorBillIntegration[]
  customerPaymentIntegrations CustomerPaymentIntegration[]
  atlassianOrders        AtlassianOrder[]
  JobSchedule              JobSchedule[]
  memberships            Membership[]
  menuConfigurations     MenuConfiguration[]
  portalPageConfigurations PortalPageConfiguration[]
  estimateSettings       EstimateSettings?
  shipmentSettings       ShipmentSettings?
  netsuiteIntegration    NetSuiteIntegration?
  orders                 Order[]
  shipmentTypeMappings   ShipmentTypeMapping[]
  shippingLabels         ShippingLabel[]
  switchPdfUploads       SwitchPdfUpload[]
  warehouses             Warehouse[]
  warehouseLocations     WarehouseLocation[]
  inventoryItems         InventoryItem[]
  inventoryStock         InventoryStock[]
  inventoryTransactions  InventoryTransaction[]
  asns                   ASN[]
  receivingRecords       ReceivingRecord[]
  gcuEnvelopeOrders      GcuEnvelopeOrder[]
  warehouseCustomers     WarehouseCustomer[]
  pickOrders             PickOrder[]
  kitAssemblies          KitAssembly[]
  storefrontOrders       StorefrontOrder[]

  @@index([slug])
  @@index([status])
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  password              String?
  passwordResetRequired Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  paceCustomerId        String?
  accounts              Account[]
  auditLogs             AuditLog[]
  departmentMemberships DepartmentMember[]
  JobSchedule           JobSchedule[]
  memberships           Membership[]
  sessions              Session[]
  inventoryTransactions InventoryTransaction[]
  receivingRecords      ReceivingRecord[]
  pickOrdersCreated     PickOrder[]            @relation("PickOrderCreatedBy")
  kitAssemblies         KitAssembly[]
  storefrontOrdersCreated StorefrontOrder[]

  @@index([email])
  @@index([paceCustomerId])
}

model Membership {
  id        String   @id @default(cuid())
  role      String   @default("customer_service")
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  status          String       @default("pending")
  customerName    String
  customerEmail   String
  customerPhone   String?
  subtotal        Decimal      @db.Decimal(10, 2)
  tax             Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  currency        String       @default("USD")
  shippingAddress Json?
  billingAddress  Json?
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attachments     Attachment[]
  auditLogs       AuditLog[]
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([tenantId])
  @@index([orderNumber])
  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  sku         String?
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  metadata    Json?
  orderId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  bucket     String
  key        String
  url        String?
  metadata   Json?
  tenantId   String
  orderId    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([key])
}

model AuditLog {
  id                 String   @id @default(cuid())
  action             String
  entityType         String
  entityId           String?
  userId             String?
  actorName          String?
  actorEmail         String?
  ipAddress          String?
  userAgent          String?
  paceTransactionId  String?  // UUID passed to PACE API for cross-referencing
  metadata           Json?
  tenantId           String
  orderId            String?
  createdAt          DateTime @default(now())
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([paceTransactionId])
}

model Integration {
  id         String   @id @default(cuid())
  provider   String
  enabled    Boolean  @default(true)
  config     Json?
  secretName String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([provider])
  @@index([enabled])
}

model NetSuiteIntegration {
  id                String   @id @default(cuid())
  sandboxEnabled    Boolean  @default(false)
  productionEnabled Boolean  @default(false)
  currentMode       String   @default("sandbox")
  tenantId          String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([currentMode])
}

model ShipmentTypeMapping {
  id                String   @id @default(cuid())
  plannedTypeId     Int
  plannedTypeName   String
  completedTypeId   Int
  completedTypeName String
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, plannedTypeId])
  @@unique([tenantId, completedTypeId])
  @@index([tenantId])
}

model CarrierServiceMapping {
  id                     String   @id @default(cuid())
  shipstationCarrierId   String
  shipstationCarrierCode String
  shipstationServiceCode String
  carrierName            String
  serviceName            String
  paceShipViaId          Int
  paceShipViaName        String
  trackingUrlTemplate    String?  // URL template with {tracking} placeholder (e.g., "https://www.fedex.com/fedextrack/?trknbr={tracking}")
  tenantId               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shipstationCarrierId, shipstationServiceCode])
  @@index([tenantId])
  @@index([shipstationCarrierCode])
  @@index([shipstationServiceCode])
}

model ShippingLabel {
  id                 String    @id @default(cuid())
  paceShipmentId     Int?
  paceCartonId       Int?
  provider           String
  providerShipmentId String?
  providerLabelId    String?
  trackingNumber     String
  labelUrl           String
  labelFormat        String?
  carrier            String
  service            String
  shipFrom           Json
  shipTo             Json
  weight             Decimal?  @db.Decimal(10, 2)
  length             Decimal?  @db.Decimal(10, 2)
  width              Decimal?  @db.Decimal(10, 2)
  height             Decimal?  @db.Decimal(10, 2)
  cost               Decimal   @db.Decimal(10, 2)
  currency           String    @default("USD")
  status             String    @default("active")
  voidedAt           DateTime?
  refundedAt         DateTime?
  isReturnLabel      Boolean   @default(false)
  outboundLabelId    String?
  rmaNumber          String?
  metadata           Json?
  tenantId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastTrackedAt      DateTime?
  trackingStatus     String?
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paceShipmentId])
  @@index([paceCartonId])
  @@index([trackingNumber])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([isReturnLabel])
  @@index([trackingStatus])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("pending")
  payload     Json?
  result      Json?
  error       String?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model BatchImport {
  id                 String            @id @default(cuid())
  fileName           String
  fileUrl            String?
  sheetName          String?
  status             BatchImportStatus @default(PENDING)
  totalRows          Int               @default(0)
  processedRows      Int               @default(0)
  successfulRows     Int               @default(0)
  failedRows         Int               @default(0)
  carrierId          String?
  carrierCode        String?
  serviceCode        String?
  carrier            String?
  service            String?
  billToParty        String            @default("sender")
  billToAccount      String?
  billToCountryCode  String            @default("US")
  billToPostalCode   String?
  containsAlcohol    Boolean           @default(false)
  saturdayDelivery   Boolean           @default(false)
  confirmation       String            @default("none")
  notificationsEmail String?
  skipAddressVerification Boolean      @default(false)
  fromAddress        Json?
  columnMapping      Json?
  originalData       Json?             // Store original CSV/Excel data for exports
  tenantId           String
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows               BatchImportRow[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model BatchImportRow {
  id                    String         @id @default(cuid())
  batchImportId         String
  rowNumber             Int
  position              String?        // User-defined position/grouping identifier
  status                BatchRowStatus @default(PENDING)
  groupKey              String?
  shipDate              DateTime?
  jobNumber             String?
  totalPackages         Int?
  packageNumber         Int?
  shipToName            String?
  shipToCompany         String?
  shipToAddress1        String?
  shipToAddress2        String?
  shipToCity            String?
  shipToState           String?
  shipToZip             String?
  shipToCountry         String         @default("US")
  shipToPhone           String?
  weight                Float?
  length                Float?
  width                 Float?
  height                Float?
  reference1            String?
  reference2            String?
  reference3            String?
  itemNumber            String?
  itemQuantity          Int?
  trackingNumber        String?
  trackingUrl           String?
  labelUrl              String?
  shippingCost          Float?
  errorMessage          String?
  notes                 String?
  retryCount            Int            @default(0)
  maxRetries            Int            @default(3)
  lastAttemptAt         DateTime?
  isTransientError      Boolean        @default(false)
  paceJobShipmentId     Int?
  paceCartonId          Int?
  shipstationShipmentId String?
  shipstationLabelId    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  processedAt           DateTime?
  batchImport           BatchImport    @relation(fields: [batchImportId], references: [id], onDelete: Cascade)

  @@index([batchImportId])
  @@index([batchImportId, status])
  @@index([groupKey])
  @@index([jobNumber])
  @@index([status])
}

model BatchImportMapping {
  id             String   @id @default(cuid())
  userId         String?
  tenantId       String?
  mappingName    String
  columnMappings Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
}

model BatchImportV2 {
  id                  String   @id @default(cuid())
  shipEngineBatchId   String   @unique
  externalBatchId     String?
  fileName            String
  sheetName           String?
  status              String   @default("open") // open, queued, processing, completed, invalid, completed_with_errors
  totalShipments      Int      @default(0)
  completedShipments  Int      @default(0)
  failedShipments     Int      @default(0)
  shippingConfig      Json?
  columnMapping       Json?
  shipmentMapping     Json?    // Maps groupKey to shipment_id and rows
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([shipEngineBatchId])
  @@index([status])
}

model Warehouse {
  id                      String   @id @default(cuid())
  name                    String
  shipEngineWarehouseId   String?  @unique
  companyName             String?
  addressLine1            String
  addressLine2            String?
  cityLocality            String
  stateProvince           String
  postalCode              String
  countryCode             String   @default("US")
  phone                   String?
  isDefault               Boolean  @default(false)
  warehouseType           WarehouseType @default(SHIPPING_ORIGIN)
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  // Warehouse Management relations
  locations               WarehouseLocation[]
  asns                    ASN[]
  receivingRecords        ReceivingRecord[]

  @@index([tenantId])
  @@index([shipEngineWarehouseId])
}

model InvoiceIntegration {
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  status            String    @default("pending")
  payload           Json
  netsuiteResponse  Json?
  netsuiteInvoiceId String?
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentToNetsuiteAt  DateTime?
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([status, retryCount])
}

model PoLineIntegration {
  id                 String    @id @default(cuid())
  uniqueId           String    // Combination of PO Number, Line ID, and timestamp (e.g., "86014-156626-1736938200000")
  poNumber           String
  poLineId           Int
  status             String    @default("pending") // pending, processing, sent, completed, failed
  payload            Json
  netsuiteResponse   Json?
  netsuiteRecordId   String?   // NetSuite Item Receipt or Bill ID
  errorMessage       String?
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  lastAttemptAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sentToNetsuiteAt   DateTime?
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([poNumber])
  @@index([poLineId])
  @@index([uniqueId])
  @@index([createdAt])
  @@index([status, retryCount])
  @@map("POLineIntegration")
}

model PoReceiptIntegration {
  id                 String    @id @default(cuid())
  uniqueId           String    // Combination of PO Number, Line ID, and timestamp (e.g., "86014-156626-1736938200000")
  poNumber           String
  poLineId           Int
  qtyReceived        Float
  status             String    @default("pending") // pending, processing, sent, completed, failed
  payload            Json
  netsuiteResponse   Json?
  netsuiteRecordId   String?   // NetSuite Item Receipt ID
  errorMessage       String?
  retryCount         Int       @default(0)
  maxRetries         Int       @default(3)
  lastAttemptAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  sentToNetsuiteAt   DateTime?
  tenantId           String
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([poNumber])
  @@index([poLineId])
  @@index([uniqueId])
  @@index([createdAt])
  @@index([status, retryCount])
  @@map("POReceiptIntegration")
}

model VendorBillIntegration {
  id                String    @id @default(cuid())
  processDate       String    // Date the vendor bills were processed (MM/DD/YYYY)
  filename          String    // Original filename from NetSuite
  status            String    @default("pending") // pending, processing, completed, failed
  recordCount       Int       @default(0)
  vendorBillCount   Int       @default(0)
  itemReceiptCount  Int       @default(0)
  csvData           String    @db.Text // Full CSV content
  payload           Json      // Full webhook payload
  processedData     Json?     // Parsed and processed CSV data
  paceResponse      Json?     // Response from PACE API
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentToPaceAt      DateTime?
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([processDate])
  @@index([createdAt])
  @@index([status, retryCount])
}

model CustomerPaymentIntegration {
  id                String    @id @default(cuid())
  processDate       String    // Date the customer payments were processed (MM/DD/YYYY)
  filename          String    // Original filename from NetSuite
  status            String    @default("pending") // pending, processing, completed, failed
  recordCount       Int       @default(0)
  paymentCount      Int       @default(0)
  csvData           String    @db.Text // Full CSV content
  payload           Json      // Full webhook payload
  processedData     Json?     // Parsed and processed CSV data
  paceResponse      Json?     // Response from PACE API
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentToPaceAt      DateTime?
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([processDate])
  @@index([createdAt])
  @@index([status, retryCount])
}

model AtlassianOrder {
  id                String    @id @default(cuid())
  orderNumber       String?   @unique // CS501, CS502, etc.
  emailMessageId    String?   @unique // IMAP message ID for tracking
  emailSubject      String?
  emailFrom         String?
  emailDate         DateTime?
  emailBodyHtml     String?   @db.Text // Original HTML email body
  status            String    @default("pending") // pending, processing, completed, failed, missing_address, potential_duplicate

  // Duplicate detection
  duplicateOfOrderId String?  // Reference to potential duplicate order
  duplicateOfOrder   AtlassianOrder? @relation("DuplicateOrders", fields: [duplicateOfOrderId], references: [id], onDelete: SetNull)
  duplicates         AtlassianOrder[] @relation("DuplicateOrders")

  // Extracted employee data
  firstName         String?
  lastName          String?
  printName         String?   // First name only for labels
  pdfPath           String?   // Path to generated PDF welcome packet
  fullName          String?
  personalEmail     String?
  workEmail         String?
  phoneNumber       String?
  address1          String?
  address2          String?
  address3          String?
  city              String?
  state             String?
  zipCode           String?
  country           String?
  countryCategory   String?   // Philippines, Australia, India, United States of America, International US

  // Additional fields from Atlassian welcome packet
  startDate         String?
  manager           String?
  department        String?
  location          String?

  // Processing metadata
  rawEmail          Json?     // Full email object for debugging
  parsedData        Json?     // Structured parsed data
  paceJobNumber     String?   // PACE-generated job number (if sent to PACE)
  paceResponse      Json?     // Response from PACE API (if applicable)
  sftpUrl           String?   // SFTP URL for the PDF file (if uploaded to SFTP)
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  processedAt       DateTime? // When successfully processed
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([emailMessageId])
  @@index([country])
  @@index([countryCategory])
  @@index([createdAt])
  @@index([status, retryCount])
  @@index([fullName])
  @@index([duplicateOfOrderId])
}

model MenuConfiguration {
  id                String   @id @default(cuid())
  menuKey           String
  label             String
  href              String
  icon              String?
  parentKey         String?
  order             Int      @default(0)
  visibleToRoles    String[]
  isActive          Boolean  @default(true)
  visibilityMode    String   @default("role") // "role", "user_ids", "user_emails", "all"
  allowedUserIds    String[] @default([])
  allowedUserEmails String[] @default([])
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, menuKey])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([order])
}

model PortalPageConfiguration {
  id                     String   @id @default(cuid())
  pageKey                String
  label                  String
  href                   String
  icon                   String?
  order                  Int      @default(0)
  isActive               Boolean  @default(true)
  description            String?
  visibilityMode         String   @default("all") // "all", "pace_ids", "user_ids", "user_emails"
  allowedPaceCustomerIds String[] @default([])
  allowedUserIds         String[] @default([])
  allowedUserEmails      String[] @default([])
  tenantId               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pageKey])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([order])
}

model EstimateSettings {
  id                        String   @id @default(cuid())
  allowedJobProductTypeIds  String[] // Array of Job Product Type IDs allowed in estimates (deprecated, use allowedJobProductTypes)
  allowedJobProductTypes    Json?    // Array of objects: { jobProductTypeId, customName?, customDescription?, allowedInventoryItemIds[] }
  tenantId                  String   @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ShipmentSettings {
  id                      String   @id @default(cuid())
  enforcePoValidation     Boolean  @default(true) // Whether to enforce PO validation before processing shipments
  tenantId                String   @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Department {
  id          String              @id @default(cuid())
  name        String
  description String?
  color       String?
  isActive    Boolean             @default(true)
  tenantId    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobTypes    DepartmentJobType[]
  members     DepartmentMember[]
  equipment   Equipment[]
  JobSchedule JobSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model DepartmentJobType {
  id            String     @id @default(cuid())
  departmentId  String
  paceJobTypeId Int
  jobTypeName   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, paceJobTypeId])
  @@index([departmentId])
  @@index([paceJobTypeId])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  role         String     @default("member")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@index([departmentId])
}

model Equipment {
  id           String        @id @default(cuid())
  name         String        // e.g., "Press 1", "Cutter A", "Folder 3"
  description  String?
  departmentId String
  isActive     Boolean       @default(true)
  metadata     Json?         // Additional specs, capacity, etc.
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules    JobSchedule[]

  @@unique([tenantId, departmentId, name])
  @@index([departmentId])
  @@index([tenantId])
  @@index([isActive])
}

model JobSchedule {
  id             String      @id
  paceJobNumber  String
  paceJobData    Json?
  departmentId   String
  equipmentId    String?     // Optional: assign to specific equipment/machine
  assignedToId   String?
  assignedToName String?
  scheduledDate  DateTime
  position       Int         @default(0)
  status         String      @default("scheduled")
  priority       String      @default("normal")
  notes          String?
  estimatedHours Float?
  actualHours    Float?
  metadata       Json?
  tenantId       String
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  completedAt    DateTime?
  User           User?       @relation(fields: [assignedToId], references: [id])
  Department     Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  Equipment      Equipment?  @relation(fields: [equipmentId], references: [id])
  Tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([departmentId])
  @@index([equipmentId])
  @@index([paceJobNumber])
  @@index([scheduledDate])
  @@index([status])
  @@index([tenantId, departmentId, scheduledDate])
  @@index([tenantId, departmentId, equipmentId, scheduledDate])
  @@index([tenantId])
}

model SwitchPdfUpload {
  id               String    @id @default(cuid())
  filename         String
  originalFilename String
  fileSize         Int
  mimeType         String    @default("application/pdf")
  s3Bucket         String?
  s3Key            String?
  s3Url            String?
  status           String    @default("pending") // pending, uploading, sent, failed
  switchSubmitUrl  String?   // The Switch endpoint URL it was sent to
  switchResponse   Json?     // Response from Switch (if any)
  errorMessage     String?
  metadata         Json?     // Job number, customer info, etc.
  tenantId         String
  uploadedBy       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sentToSwitchAt   DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@index([uploadedBy])
}

model GcuEnvelopeOrder {
  id              String    @id @default(cuid())
  orderNumber     String    @unique // Auto-generated order number
  orderId         String    // User-provided order/reference ID
  quantity        Int
  position        String    // 'center back flap' or 'front'
  address         String    @db.Text

  // PDF Storage
  printPdfBucket  String?   // S3 bucket for PRINT PDF
  printPdfKey     String?   // S3 key for PRINT PDF
  printPdfUrl     String?   // Public URL for PRINT PDF
  proofPdfBucket  String?   // S3 bucket for PROOF PDF (optional, for reference)
  proofPdfKey     String?   // S3 key for PROOF PDF
  proofPdfUrl     String?   // Public URL for PROOF PDF

  // Approval & Status
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  status          String    @default("draft") // draft, pending, approved, processing, completed, cancelled

  // User & Tenant
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       String    // User ID who created the order
  createdByEmail  String    // Email of user who created the order

  // Metadata
  notes           String?   @db.Text
  metadata        Json?     // Additional order metadata

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  submittedAt     DateTime? // When order was submitted/approved

  @@index([tenantId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdBy])
  @@index([createdByEmail])
  @@index([createdAt])
}

model HolidayGiftOrder {
  id           String   @id @default(cuid())
  giftId       String   // 'chill-out', 'game-night', 'get-moving', 'mystery'
  giftName     String
  firstName    String
  lastName     String
  email        String
  phone        String
  address      String
  city         String
  state        String
  zipCode      String
  country      String
  status       String   @default("pending") // pending, processing, shipped, delivered, cancelled
  metadata     Json?    // Any additional data
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shippedAt    DateTime?
  deliveredAt  DateTime?

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([giftId])
}

enum BatchImportStatus {
  PENDING
  PROCESSING
  COMPLETE
  CANCELLED
}

enum BatchRowStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}

// ============================================
// WAREHOUSE MANAGEMENT SYSTEM ENUMS
// ============================================

enum LocationType {
  RECEIVING   // Dock/receiving area
  STORAGE     // Primary storage locations
  SHIPPING    // Shipping/staging area
  STAGING     // Temporary staging area
  QUARANTINE  // Quality hold / damaged goods
}

enum WarehouseType {
  SHIPPING_ORIGIN    // Ship-from address for labels (main app)
  STORAGE_FACILITY   // Inventory storage (WMS)
  BOTH               // Can be used for both shipping and storage
}

enum InventoryTransactionType {
  RECEIVE       // Inbound from receiving
  SHIP          // Outbound shipment
  ADJUST        // Manual adjustment (cycle count, correction)
  TRANSFER      // Transfer between locations
  RESERVE       // Reserved for order
  UNRESERVE     // Released from reservation
  DAMAGE        // Marked as damaged
  PICK          // Picked for internal use (fulfillment job, etc.)
  KIT_ASSEMBLE  // Component consumed for kit assembly
  KIT_PRODUCE   // Kit produced from assembly
}

enum PickOrderStatus {
  DRAFT       // Not yet ready to pick
  PENDING     // Ready to be picked
  IN_PROGRESS // Currently being picked
  COMPLETED   // All items picked
  CANCELLED   // Cancelled
}

enum StorefrontOrderStatus {
  CREATED     // Order placed, items reserved
  SHIPPED     // Items pulled from inventory and shipped
  CANCELLED   // Order cancelled, reserved items released
}

enum ItemType {
  STANDARD           // Regular item, sold/used alone
  KIT_COMPONENT      // Only used as part of kits
  KIT_AND_COMPONENT  // Can be used alone AND as part of kits
  KIT                // Assembled product with components
}

enum ASNStatus {
  DRAFT              // Not yet submitted
  PENDING            // Submitted, awaiting arrival
  IN_TRANSIT         // Carrier has picked up
  ARRIVED            // At receiving dock
  RECEIVING          // Currently being received
  RECEIVED           // Fully received
  PARTIALLY_RECEIVED // Some items received, discrepancies
  CANCELLED          // Cancelled
}

enum ReceivingStatus {
  IN_PROGRESS                // Receiving in progress
  COMPLETED                  // All items received as expected
  COMPLETED_WITH_DISCREPANCY // Completed but with variance
}

enum FulfillmentTaskType {
  PICK      // Pick items from locations
  PACK      // Pack items for shipment
  SHIP      // Generate label and ship
  PUT_AWAY  // Put received items into storage
  COUNT     // Cycle count / inventory count
  TRANSFER  // Move inventory between locations
}

enum FulfillmentTaskStatus {
  PENDING     // Not yet started
  ASSIGNED    // Assigned to a user
  IN_PROGRESS // Currently being worked on
  COMPLETED   // Finished
  CANCELLED   // Cancelled
}

// ============================================
// WAREHOUSE MANAGEMENT SYSTEM MODELS
// ============================================

model WarehouseLocation {
  id            String       @id @default(cuid())
  tenantId      String
  warehouseId   String

  // Location identifiers
  zone          String?      // e.g., "A", "B", "RECV"
  aisle         String?      // e.g., "01", "02"
  rack          String?      // e.g., "01", "02"
  shelf         String?      // e.g., "A", "B", "C"
  bin           String?      // e.g., "01", "02"

  // Full location code (generated or manual)
  barcode       String       // Scannable code, e.g., "A-01-02-B-03"
  name          String?      // Human-friendly name, e.g., "Receiving Dock 1"

  // Classification
  locationType  LocationType @default(STORAGE)

  // Capacity (optional)
  maxCapacity   Int?         // Max units this location can hold

  // Status
  isActive      Boolean      @default(true)

  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stockLevels     InventoryStock[]
  transactions    InventoryTransaction[]
  receivingItems  ReceivingItem[]
  pickOrderItems  PickOrderItem[]
  kitAssemblies   KitAssembly[]

  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([locationType])
  @@index([isActive])
  @@index([zone])
}

model InventoryItem {
  id            String       @id @default(cuid())
  tenantId      String

  // Customer ownership (optional - for 3PL operations)
  customerId    String?      // Reference to WarehouseCustomer

  // Item identifiers
  itemCode      String?      // Human-friendly code: CSI-0001, CSI-0002, etc.
  sku           String?      // Stock Keeping Unit (optional, unique per tenant if provided)
  upc           String?      // Universal Product Code (barcode)
  name          String       // Item name
  description   String?      @db.Text

  // Classification
  category      String?      // Product category
  itemType      ItemType     @default(STANDARD) // Item type (standard, kit, component, etc.)

  // Physical attributes
  weight        Decimal?     @db.Decimal(10, 3) // Weight in lbs
  dimensions    Json?        // { length, width, height, unit }

  // Pricing
  sellPrice       Decimal?   @db.Decimal(10, 2) // Price per individual unit

  // Bulk/Case ordering
  canOrderInBulk  Boolean    @default(false)  // Can this item be ordered in bulk (cases)?
  bulkUnitName    String?    // Name of bulk unit (e.g., "Case", "Carton", "Box", "Pallet")
  unitsPerBulk    Int?       // How many individual units per bulk unit
  bulkSellPrice   Decimal?   @db.Decimal(10, 2) // Price per bulk unit (e.g., per case)

  // Status
  isActive      Boolean      @default(true)

  // Tracking requirements
  trackByReference  Boolean  @default(false)  // If true, inventory must be tracked by PO/reference number

  // Additional data
  metadata      Json?        // Custom fields, vendor info, etc.

  // Timestamps
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        WarehouseCustomer? @relation(fields: [customerId], references: [id])
  stockLevels     InventoryStock[]
  transactions    InventoryTransaction[]
  asnItems        ASNItem[]
  receivingItems  ReceivingItem[]
  pickOrderItems  PickOrderItem[]

  // Kit relations
  kitComponents   KitComponent[]     @relation("Kit")        // Components that make up this kit
  usedInKits      KitComponent[]     @relation("Component")  // Kits that use this item
  kitAssemblies   KitAssembly[]      @relation("KitAssemblies") // Assembly history for this kit

  // Add-on relations
  addOns          ItemAddOn[]        @relation("ParentItem")  // Add-ons for this item
  addOnFor        ItemAddOn[]        @relation("AddOnItem")   // Items this is an add-on for

  // Storefront order relations
  storefrontOrderItems StorefrontOrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, itemCode])
  @@index([tenantId])
  @@index([customerId])
  @@index([itemCode])
  @@index([sku])
  @@index([upc])
  @@index([category])
  @@index([itemType])
  @@index([isActive])
  @@index([name])
}

model InventoryStock {
  id              String             @id @default(cuid())
  tenantId        String

  // Item reference
  itemId          String             // Reference to InventoryItem
  locationId      String             // Reference to WarehouseLocation

  // Quantity tracking
  available       Int                @default(0) // Available for picking
  reserved        Int                @default(0) // Reserved for orders
  damaged         Int                @default(0) // Damaged/unsellable
  onHold          Int                @default(0) // On hold for QC or other reasons

  // Lot tracking (optional)
  lotNumber       String?            // Lot/batch number
  expirationDate  DateTime?          // Expiration date for perishables

  // Reference tracking (optional - for PO#, job#, etc.)
  referenceNumber String?            // PO number, job number, or other reference

  // Timestamps
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  // Relations
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location        WarehouseLocation  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, locationId, lotNumber, referenceNumber])
  @@index([tenantId])
  @@index([itemId])
  @@index([locationId])
  @@index([lotNumber])
  @@index([referenceNumber])
  @@index([expirationDate])
}

model InventoryTransaction {
  id              String                     @id @default(cuid())
  tenantId        String

  // What changed
  itemId          String                     // Reference to InventoryItem
  locationId      String                     // Reference to WarehouseLocation
  type            InventoryTransactionType   // Type of transaction

  // Quantity change
  quantity        Int                        // Positive or negative
  previousQty     Int                        // Quantity before change
  newQty          Int                        // Quantity after change

  // Reference to source document
  referenceType   String?                    // 'ASN', 'ORDER', 'ADJUSTMENT', 'TRANSFER', etc.
  referenceId     String?                    // ID of the source document

  // Tracking fields (for filtering by lot/PO)
  lotNumber       String?                    // Lot/batch number
  referenceNumber String?                    // PO number, job number, or other reference

  // Audit fields
  userId          String?                    // Who made the change
  notes           String?                    @db.Text

  // Timestamps
  createdAt       DateTime                   @default(now())

  // Relations
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item            InventoryItem              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location        WarehouseLocation          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user            User?                      @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([itemId])
  @@index([locationId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([lotNumber])
  @@index([referenceNumber])
  @@index([userId])
  @@index([createdAt])
}

// ASN (Advanced Shipping Notice) - Inbound shipment notifications
model ASN {
  id              String     @id @default(cuid())
  asnNumber       String     // Human-readable ASN number (e.g., ASN-2024-0001)
  tenantId        String

  // Customer (optional - for 3PL operations, whose inventory is this?)
  customerId      String?    // Reference to WarehouseCustomer

  // Vendor/Supplier info
  vendorId        String?    // Reference to portal user/vendor (optional)
  vendorName      String     // Vendor/supplier name (for display)
  vendorEmail     String?    // Vendor contact email

  // Shipment details
  warehouseId     String     // Destination warehouse
  expectedDate    DateTime   // Expected arrival date
  carrier         String?    // Carrier name (FedEx, UPS, etc.)
  trackingNumber  String?    // Tracking number
  poNumber        String?    // Purchase order reference

  // Status
  status          ASNStatus  @default(DRAFT)

  // Metadata
  notes           String?    @db.Text
  metadata        Json?      // Additional custom fields

  // Timestamps
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  arrivedAt       DateTime?  // When shipment arrived
  receivedAt      DateTime?  // When fully received

  // Relations
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        WarehouseCustomer? @relation(fields: [customerId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  items           ASNItem[]
  receivingRecord ReceivingRecord?   // One-to-one relation with receiving

  @@unique([tenantId, asnNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([vendorId])
  @@index([warehouseId])
  @@index([status])
  @@index([expectedDate])
  @@index([poNumber])
}

// ASN Line Items - Individual items expected in the shipment
model ASNItem {
  id              String     @id @default(cuid())
  asnId           String

  // Item info (either linked to InventoryItem or manual entry)
  itemId          String?    // Reference to InventoryItem (optional)
  sku             String     // SKU (can be manual entry if item doesn't exist)
  description     String     // Item description

  // Quantities
  expectedQty     Int        // Quantity expected
  receivedQty     Int        @default(0) // Quantity received so far

  // Lot tracking (optional)
  lotNumber       String?
  expirationDate  DateTime?

  // Metadata
  metadata        Json?

  // Relations
  asn             ASN        @relation(fields: [asnId], references: [id], onDelete: Cascade)
  item            InventoryItem? @relation(fields: [itemId], references: [id])

  @@index([asnId])
  @@index([itemId])
  @@index([sku])
}

// ============================================
// RECEIVING MODELS
// ============================================

// Receiving Record - A receiving session for inbound goods
model ReceivingRecord {
  id                String           @id @default(cuid())
  tenantId          String

  // Link to ASN (optional - can receive without ASN)
  asnId             String?          @unique // One receiving record per ASN

  // Warehouse
  warehouseId       String           // Where goods are being received

  // Receiver info
  receivedById      String           // User who performed receiving

  // Status
  status            ReceivingStatus  @default(IN_PROGRESS)

  // Notes
  notes             String?          @db.Text
  discrepancyNotes  String?          @db.Text // Notes about variances

  // Timestamps
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  completedAt       DateTime?        // When receiving was completed

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asn               ASN?             @relation(fields: [asnId], references: [id])
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])
  receivedBy        User             @relation(fields: [receivedById], references: [id])
  items             ReceivingItem[]

  @@index([tenantId])
  @@index([asnId])
  @@index([warehouseId])
  @@index([receivedById])
  @@index([status])
  @@index([createdAt])
}

// Receiving Item - Individual items received in a receiving session
model ReceivingItem {
  id                  String              @id @default(cuid())
  receivingRecordId   String

  // Item info
  itemId              String?             // Reference to InventoryItem (optional)
  sku                 String              // SKU
  description         String              // Item description

  // Quantities
  expectedQty         Int                 @default(0) // Expected from ASN (0 if no ASN)
  receivedQty         Int                 @default(0) // Actually received
  damagedQty          Int                 @default(0) // Received but damaged

  // Put-away location
  putAwayLocationId   String?             // Where item was put away

  // Lot tracking
  lotNumber           String?
  expirationDate      DateTime?

  // Reference tracking (PO#, job#, etc.)
  referenceNumber     String?

  // Notes
  notes               String?             @db.Text

  // Relations
  receivingRecord     ReceivingRecord     @relation(fields: [receivingRecordId], references: [id], onDelete: Cascade)
  item                InventoryItem?      @relation(fields: [itemId], references: [id])
  putAwayLocation     WarehouseLocation?  @relation(fields: [putAwayLocationId], references: [id])

  @@index([receivingRecordId])
  @@index([itemId])
  @@index([referenceNumber])
  @@index([sku])
  @@index([putAwayLocationId])
}

// ============================================
// WAREHOUSE CUSTOMER (PACE Customer Cache)
// ============================================

// WarehouseCustomer - Locally cached PACE customers enabled for warehouse operations
model WarehouseCustomer {
  id              String    @id @default(cuid())
  tenantId        String

  // PACE Integration
  paceCustomerId  String    // ID from PACE system
  name            String    // Customer name from PACE
  company         String?   // Company name

  // Contact Info
  email           String?
  phone           String?

  // Default Shipping Address
  shipToName      String?   // Attention/Contact name
  shipToAddress1  String?
  shipToAddress2  String?
  shipToCity      String?
  shipToState     String?
  shipToZip       String?
  shipToCountry   String?   @default("US")
  shipToPhone     String?

  // Status
  isActive        Boolean   @default(true)

  // Sync tracking
  lastSyncedAt    DateTime  @default(now())

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  asns            ASN[]
  storefrontOrders StorefrontOrder[]

  @@unique([tenantId, paceCustomerId])
  @@index([tenantId])
  @@index([paceCustomerId])
  @@index([isActive])
  @@index([name])
}

// ============================================
// STOREFRONT ORDER MODELS
// ============================================

// StorefrontOrder - Customer order for warehouse items
model StorefrontOrder {
  id              String                @id @default(cuid())
  orderNumber     String                // Human-readable number (e.g., SO-2024-0001)
  tenantId        String
  customerId      String

  // Status
  status          StorefrontOrderStatus @default(CREATED)

  // Shipping Address (copied from customer or overridden)
  shipToName      String?
  shipToAddress1  String?
  shipToAddress2  String?
  shipToCity      String?
  shipToState     String?
  shipToZip       String?
  shipToCountry   String?   @default("US")
  shipToPhone     String?

  // Order notes
  notes           String?   @db.Text

  // Tracking info (populated when shipped)
  shippedAt       DateTime?
  trackingNumber  String?
  carrier         String?

  // PACE Integration
  paceJobNumber   String?   // Job number from PACE system
  paceResponse    Json?     // Full PACE API response for audit

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?

  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer        WarehouseCustomer @relation(fields: [customerId], references: [id])
  createdBy       User?     @relation(fields: [createdById], references: [id])
  items           StorefrontOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([paceJobNumber])
}

// StorefrontOrderItem - Line items in a storefront order
model StorefrontOrderItem {
  id              String    @id @default(cuid())
  orderId         String
  itemId          String

  // Quantity
  quantity        Int

  // Price at time of order (optional, for record keeping)
  unitPrice       Decimal?  @db.Decimal(12, 4)

  // Bulk order tracking
  isBulkOrder     Boolean   @default(false)

  // Reference/Lot tracking (if item tracks by reference)
  referenceNumber String?
  lotNumber       String?

  // Notes
  notes           String?

  // PACE integration - stores the JobPart number (01, 02, etc.) when order is sent to PACE
  paceJobPart     String?

  // Relations
  order           StorefrontOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            InventoryItem   @relation(fields: [itemId], references: [id])

  @@index([orderId])
  @@index([itemId])
}

// ============================================
// PICK ORDER MODELS (Module 6 - Fulfillment)
// ============================================

// PickOrder - Request to pick items from warehouse for fulfillment/internal use
model PickOrder {
  id              String          @id @default(cuid())
  pickOrderNumber String          // Human-readable number (e.g., PO-2024-0001)
  tenantId        String

  // Status
  status          PickOrderStatus @default(DRAFT)

  // Destination info (where items are going)
  destination     String          // Destination name/description (e.g., "Press Room", "Fulfillment Area", "External Warehouse")
  destinationNotes String?        @db.Text

  // Priority
  priority        String          @default("normal") // low, normal, high, urgent

  // Notes
  notes           String?         @db.Text

  // Created by user
  createdById     String?

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?       // When all items were picked

  // Relations
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("PickOrderCreatedBy", fields: [createdById], references: [id])
  items           PickOrderItem[]

  @@unique([tenantId, pickOrderNumber])
  @@index([tenantId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([createdById])
}

// PickOrderItem - Individual items to pick
model PickOrderItem {
  id              String          @id @default(cuid())
  pickOrderId     String

  // Item info
  itemId          String          // Reference to InventoryItem

  // Location to pick from (can be null = system will suggest or user chooses)
  locationId      String?         // Reference to WarehouseLocation

  // Reference tracking (for items tracked by PO#)
  referenceNumber String?         // PO number to pick from
  lotNumber       String?         // Lot number to pick from

  // Quantities
  requestedQty    Int             // Quantity requested to pick
  pickedQty       Int             @default(0) // Quantity actually picked

  // Status
  isPicked        Boolean         @default(false) // True when item is fully picked

  // Notes
  notes           String?         @db.Text

  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pickedAt        DateTime?       // When item was picked

  // Relations
  pickOrder       PickOrder       @relation(fields: [pickOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem   @relation(fields: [itemId], references: [id])
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])

  @@index([pickOrderId])
  @@index([itemId])
  @@index([locationId])
  @@index([referenceNumber])
  @@index([isPicked])
}

// ============================================
// KIT/ASSEMBLY MODELS
// ============================================

// KitComponent - Bill of Materials for Kit items
model KitComponent {
  id           String        @id @default(cuid())

  // The kit this component belongs to
  kitId        String
  kit          InventoryItem @relation("Kit", fields: [kitId], references: [id], onDelete: Cascade)

  // The component item
  componentId  String
  component    InventoryItem @relation("Component", fields: [componentId], references: [id], onDelete: Cascade)

  // Quantity of this component per kit
  quantity     Int           // How many of this component needed per 1 kit

  // Assembly order (for pick lists)
  sortOrder    Int           @default(0)

  // Notes for assembly
  notes        String?       @db.Text

  // Timestamps
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([kitId, componentId])
  @@index([kitId])
  @@index([componentId])
}

// KitAssembly - Tracks kit assembly operations
model KitAssembly {
  id            String              @id @default(cuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // The kit being assembled
  kitId         String
  kit           InventoryItem       @relation("KitAssemblies", fields: [kitId], references: [id], onDelete: Cascade)

  // Where the kit is being produced
  locationId    String
  location      WarehouseLocation   @relation(fields: [locationId], references: [id])

  // Assembly details
  quantity      Int                 // Number of kits assembled
  status        KitAssemblyStatus   @default(COMPLETED)

  // Who performed the assembly
  assembledById String?
  assembledBy   User?               @relation(fields: [assembledById], references: [id])

  // Notes
  notes         String?             @db.Text

  // Timestamps
  assembledAt   DateTime            @default(now())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([tenantId])
  @@index([kitId])
  @@index([locationId])
  @@index([assembledAt])
}

enum KitAssemblyStatus {
  COMPLETED   // Assembly completed successfully
  CANCELLED   // Assembly was cancelled/reversed
}

// ============================================
// ITEM ADD-ONS MODELS
// ============================================

enum AddOnApplyTo {
  INDIVIDUAL_ONLY  // Only include add-on when ordering individually
  BULK_ONLY        // Only include add-on when ordering in bulk
  BOTH             // Include add-on in both individual and bulk orders
}

// ItemAddOn - Bundled/included items that are automatically added to an item
model ItemAddOn {
  id              String        @id @default(cuid())

  // The parent item that has this add-on
  parentItemId    String
  parentItem      InventoryItem @relation("ParentItem", fields: [parentItemId], references: [id], onDelete: Cascade)

  // The add-on item that gets included
  addOnItemId     String
  addOnItem       InventoryItem @relation("AddOnItem", fields: [addOnItemId], references: [id], onDelete: Cascade)

  // When does this add-on apply?
  applyTo         AddOnApplyTo  @default(BOTH)

  // Quantity of add-on per parent item (for individual orders)
  quantity        Int           @default(1)

  // Optional: Different quantity for bulk orders (if null, uses regular quantity)
  bulkQuantity    Int?          // Quantity per bulk unit (e.g., 5 add-ons per case)

  // Display order
  sortOrder       Int           @default(0)

  // Notes
  notes           String?       @db.Text

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([parentItemId, addOnItemId])
  @@index([parentItemId])
  @@index([addOnItemId])
  @@index([applyTo])
}
