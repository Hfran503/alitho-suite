generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Tenant {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  plan                   String                  @default("free")
  status                 String                  @default("active")
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  attachments            Attachment[]
  auditLogs              AuditLog[]
  batchImports           BatchImport[]
  batchImportsV2         BatchImportV2[]
  carrierServiceMappings CarrierServiceMapping[]
  departments            Department[]
  equipment              Equipment[]
  integrations           Integration[]
  invoiceIntegrations    InvoiceIntegration[]
  JobSchedule            JobSchedule[]
  memberships            Membership[]
  menuConfigurations     MenuConfiguration[]
  estimateSettings       EstimateSettings?
  netsuiteIntegration    NetSuiteIntegration?
  orders                 Order[]
  shipmentTypeMappings   ShipmentTypeMapping[]
  shippingLabels         ShippingLabel[]
  warehouses             Warehouse[]

  @@index([slug])
  @@index([status])
}

model User {
  id                    String             @id @default(cuid())
  email                 String             @unique
  emailVerified         DateTime?
  name                  String?
  image                 String?
  password              String?
  passwordResetRequired Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  paceCustomerId        String?
  accounts              Account[]
  auditLogs             AuditLog[]
  departmentMemberships DepartmentMember[]
  JobSchedule           JobSchedule[]
  memberships           Membership[]
  sessions              Session[]

  @@index([email])
  @@index([paceCustomerId])
}

model Membership {
  id        String   @id @default(cuid())
  role      String   @default("customer_service")
  userId    String
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  expires      DateTime
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  status          String       @default("pending")
  customerName    String
  customerEmail   String
  customerPhone   String?
  subtotal        Decimal      @db.Decimal(10, 2)
  tax             Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  currency        String       @default("USD")
  shippingAddress Json?
  billingAddress  Json?
  notes           String?
  metadata        Json?
  tenantId        String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  attachments     Attachment[]
  auditLogs       AuditLog[]
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items           OrderItem[]

  @@index([tenantId])
  @@index([orderNumber])
  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  sku         String?
  name        String
  description String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  metadata    Json?
  orderId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Attachment {
  id         String   @id @default(cuid())
  filename   String
  mimeType   String
  size       Int
  bucket     String
  key        String
  url        String?
  metadata   Json?
  tenantId   String
  orderId    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([orderId])
  @@index([key])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  actorName  String?
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  tenantId   String
  orderId    String?
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Integration {
  id         String   @id @default(cuid())
  provider   String
  enabled    Boolean  @default(true)
  config     Json?
  secretName String?
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([provider])
  @@index([enabled])
}

model NetSuiteIntegration {
  id                String   @id @default(cuid())
  sandboxEnabled    Boolean  @default(false)
  productionEnabled Boolean  @default(false)
  currentMode       String   @default("sandbox")
  tenantId          String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([currentMode])
}

model ShipmentTypeMapping {
  id                String   @id @default(cuid())
  plannedTypeId     Int
  plannedTypeName   String
  completedTypeId   Int
  completedTypeName String
  tenantId          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, plannedTypeId])
  @@unique([tenantId, completedTypeId])
  @@index([tenantId])
}

model CarrierServiceMapping {
  id                     String   @id @default(cuid())
  shipstationCarrierId   String
  shipstationCarrierCode String
  shipstationServiceCode String
  carrierName            String
  serviceName            String
  paceShipViaId          Int
  paceShipViaName        String
  tenantId               String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shipstationCarrierId, shipstationServiceCode])
  @@index([tenantId])
  @@index([shipstationCarrierCode])
  @@index([shipstationServiceCode])
}

model ShippingLabel {
  id                 String    @id @default(cuid())
  paceShipmentId     Int?
  paceCartonId       Int?
  provider           String
  providerShipmentId String?
  providerLabelId    String?
  trackingNumber     String
  labelUrl           String
  labelFormat        String?
  carrier            String
  service            String
  shipFrom           Json
  shipTo             Json
  weight             Decimal?  @db.Decimal(10, 2)
  length             Decimal?  @db.Decimal(10, 2)
  width              Decimal?  @db.Decimal(10, 2)
  height             Decimal?  @db.Decimal(10, 2)
  cost               Decimal   @db.Decimal(10, 2)
  currency           String    @default("USD")
  status             String    @default("active")
  voidedAt           DateTime?
  refundedAt         DateTime?
  isReturnLabel      Boolean   @default(false)
  outboundLabelId    String?
  rmaNumber          String?
  metadata           Json?
  tenantId           String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastTrackedAt      DateTime?
  trackingStatus     String?
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paceShipmentId])
  @@index([paceCartonId])
  @@index([trackingNumber])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@index([isReturnLabel])
  @@index([trackingStatus])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("pending")
  payload     Json?
  result      Json?
  error       String?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model BatchImport {
  id                 String            @id @default(cuid())
  fileName           String
  fileUrl            String?
  sheetName          String?
  status             BatchImportStatus @default(PENDING)
  totalRows          Int               @default(0)
  processedRows      Int               @default(0)
  successfulRows     Int               @default(0)
  failedRows         Int               @default(0)
  carrierId          String?
  carrierCode        String?
  serviceCode        String?
  carrier            String?
  service            String?
  billToParty        String            @default("sender")
  billToAccount      String?
  billToCountryCode  String            @default("US")
  billToPostalCode   String?
  containsAlcohol    Boolean           @default(false)
  saturdayDelivery   Boolean           @default(false)
  confirmation       String            @default("none")
  notificationsEmail String?
  fromAddress        Json?
  columnMapping      Json?
  originalData       Json?             // Store original CSV/Excel data for exports
  tenantId           String
  createdBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  startedAt          DateTime?
  completedAt        DateTime?
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows               BatchImportRow[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model BatchImportRow {
  id                    String         @id @default(cuid())
  batchImportId         String
  rowNumber             Int
  position              String?        // User-defined position/grouping identifier
  status                BatchRowStatus @default(PENDING)
  groupKey              String?
  shipDate              DateTime?
  jobNumber             String?
  totalPackages         Int?
  packageNumber         Int?
  shipToName            String?
  shipToCompany         String?
  shipToAddress1        String?
  shipToAddress2        String?
  shipToCity            String?
  shipToState           String?
  shipToZip             String?
  shipToCountry         String         @default("US")
  shipToPhone           String?
  weight                Float?
  length                Float?
  width                 Float?
  height                Float?
  reference1            String?
  reference2            String?
  reference3            String?
  itemNumber            String?
  itemQuantity          Int?
  trackingNumber        String?
  trackingUrl           String?
  labelUrl              String?
  shippingCost          Float?
  errorMessage          String?
  notes                 String?
  retryCount            Int            @default(0)
  maxRetries            Int            @default(3)
  lastAttemptAt         DateTime?
  isTransientError      Boolean        @default(false)
  paceJobShipmentId     Int?
  paceCartonId          Int?
  shipstationShipmentId String?
  shipstationLabelId    String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  processedAt           DateTime?
  batchImport           BatchImport    @relation(fields: [batchImportId], references: [id], onDelete: Cascade)

  @@index([batchImportId])
  @@index([batchImportId, status])
  @@index([groupKey])
  @@index([jobNumber])
  @@index([status])
}

model BatchImportMapping {
  id             String   @id @default(cuid())
  userId         String?
  tenantId       String?
  mappingName    String
  columnMappings Json
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([tenantId])
}

model BatchImportV2 {
  id                  String   @id @default(cuid())
  shipEngineBatchId   String   @unique
  externalBatchId     String?
  fileName            String
  sheetName           String?
  status              String   @default("open") // open, queued, processing, completed, invalid, completed_with_errors
  totalShipments      Int      @default(0)
  completedShipments  Int      @default(0)
  failedShipments     Int      @default(0)
  shippingConfig      Json?
  columnMapping       Json?
  shipmentMapping     Json?    // Maps groupKey to shipment_id and rows
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId])
  @@index([shipEngineBatchId])
  @@index([status])
}

model Warehouse {
  id                      String   @id @default(cuid())
  name                    String
  shipEngineWarehouseId   String?  @unique
  companyName             String?
  addressLine1            String
  addressLine2            String?
  cityLocality            String
  stateProvince           String
  postalCode              String
  countryCode             String   @default("US")
  phone                   String?
  isDefault               Boolean  @default(false)
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([tenantId])
  @@index([shipEngineWarehouseId])
}

model InvoiceIntegration {
  id                String    @id @default(cuid())
  invoiceNumber     String    @unique
  status            String    @default("pending")
  payload           Json
  netsuiteResponse  Json?
  netsuiteInvoiceId String?
  errorMessage      String?
  retryCount        Int       @default(0)
  maxRetries        Int       @default(3)
  lastAttemptAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentToNetsuiteAt  DateTime?
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@index([status, retryCount])
}

model MenuConfiguration {
  id             String   @id @default(cuid())
  menuKey        String
  label          String
  href           String
  icon           String?
  parentKey      String?
  order          Int      @default(0)
  visibleToRoles String[]
  isActive       Boolean  @default(true)
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, menuKey])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([order])
}

model EstimateSettings {
  id                        String   @id @default(cuid())
  allowedJobProductTypeIds  String[] // Array of Job Product Type IDs allowed in estimates (deprecated, use allowedJobProductTypes)
  allowedJobProductTypes    Json?    // Array of objects: { jobProductTypeId, customName?, customDescription?, allowedInventoryItemIds[] }
  tenantId                  String   @unique
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  tenant                    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Department {
  id          String              @id @default(cuid())
  name        String
  description String?
  color       String?
  isActive    Boolean             @default(true)
  tenantId    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobTypes    DepartmentJobType[]
  members     DepartmentMember[]
  equipment   Equipment[]
  JobSchedule JobSchedule[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([isActive])
}

model DepartmentJobType {
  id            String     @id @default(cuid())
  departmentId  String
  paceJobTypeId Int
  jobTypeName   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, paceJobTypeId])
  @@index([departmentId])
  @@index([paceJobTypeId])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  role         String     @default("member")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@index([departmentId])
}

model Equipment {
  id           String        @id @default(cuid())
  name         String        // e.g., "Press 1", "Cutter A", "Folder 3"
  description  String?
  departmentId String
  isActive     Boolean       @default(true)
  metadata     Json?         // Additional specs, capacity, etc.
  tenantId     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  department   Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  schedules    JobSchedule[]

  @@unique([tenantId, departmentId, name])
  @@index([departmentId])
  @@index([tenantId])
  @@index([isActive])
}

model JobSchedule {
  id             String      @id
  paceJobNumber  String
  paceJobData    Json?
  departmentId   String
  equipmentId    String?     // Optional: assign to specific equipment/machine
  assignedToId   String?
  assignedToName String?
  scheduledDate  DateTime
  position       Int         @default(0)
  status         String      @default("scheduled")
  priority       String      @default("normal")
  notes          String?
  estimatedHours Float?
  actualHours    Float?
  metadata       Json?
  tenantId       String
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime
  completedAt    DateTime?
  User           User?       @relation(fields: [assignedToId], references: [id])
  Department     Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  Equipment      Equipment?  @relation(fields: [equipmentId], references: [id])
  Tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([assignedToId])
  @@index([departmentId])
  @@index([equipmentId])
  @@index([paceJobNumber])
  @@index([scheduledDate])
  @@index([status])
  @@index([tenantId, departmentId, scheduledDate])
  @@index([tenantId, departmentId, equipmentId, scheduledDate])
  @@index([tenantId])
}

enum BatchImportStatus {
  PENDING
  PROCESSING
  COMPLETE
  CANCELLED
}

enum BatchRowStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
}
