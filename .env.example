# Calitho Suite - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# DATABASE (Neon PostgreSQL)
# ==============================================
# Get your connection string from: https://console.neon.tech
#
# LOCAL DEVELOPMENT: Set these values here
# PRODUCTION: These will be fetched from AWS Secrets Manager
#             Run: pnpm secrets:setup to configure AWS Secrets Manager
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
SHADOW_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ==============================================
# REDIS (Local or Upstash)
# ==============================================
# Local: redis://localhost:6379
# Upstash: Get from https://console.upstash.com
REDIS_URL=redis://localhost:6379

# ==============================================
# NEXTAUTH (Authentication)
# ==============================================
# Production URL (change to your domain)
NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
# ⚠️ MUST be different in production!
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ==============================================
# AWS S3 (File Storage)
# ==============================================
# Bucket name (must be globally unique)
S3_BUCKET=your-bucket-name
S3_REGION=us-west-1

# AWS Credentials:
# - LOCAL DEV: Use AWS CLI (run: aws configure)
# - PRODUCTION: Use IAM roles (no credentials needed)
# - MINIO ONLY: Uncomment lines below
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ==============================================
# PACE API Integration
# ==============================================
# PACE API base URL - use the /rpc/rest/services path
# Example: http://192.168.1.218/rpc/rest/services
PACE_API_URL=http://192.168.1.218/rpc/rest/services

# PACE API Authentication - Basic Auth (username/password)
PACE_USERNAME=your-username
PACE_PASSWORD=your-password

# ==============================================
# TIMEZONE CONFIGURATION
# ==============================================
# Application timezone - all dates will be displayed in this timezone
# Default: America/Los_Angeles (Pacific Time)
# Other examples: America/New_York, America/Chicago, America/Denver
TZ=America/Los_Angeles

# ==============================================
# NETSUITE INTEGRATION
# ==============================================
# NetSuite RESTlet URLs (get these after deploying RESTlet scripts in NetSuite)
# Invoice RESTlet URL (for processing invoices)
NETSUITE_RESTLET_URL=https://YOUR_ACCOUNT_ID.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=XXXX&deploy=1

# PO Line RESTlet URL (for processing purchase order lines)
NETSUITE_PO_LINE_RESTLET_URL=https://YOUR_ACCOUNT_ID.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=XXXX&deploy=1

# ==============================================
# ENFOCUS SWITCH INTEGRATION (SFTP)
# ==============================================
# SFTP server configuration for Enfocus Switch
# PDFs uploaded via web app will be sent to this SFTP server
# Switch will monitor this folder using "FTP receive" element

# SFTP server hostname or IP
SFTP_HOST=192.168.1.100

# SFTP port (default: 22)
SFTP_PORT=22

# SFTP username
SFTP_USERNAME=switchuser

# SFTP password (use either password OR private key)
SFTP_PASSWORD=your-secure-password

# OR use SSH private key (alternative to password)
# SFTP_PRIVATE_KEY=/path/to/private/key

# Upload folder path on SFTP server (must exist and be writable)
# Switch will monitor this folder with "FTP receive" element
SFTP_UPLOAD_PATH=/switch-inbox
